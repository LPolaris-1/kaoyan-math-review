{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/build-selfhost.mjs",
    "build:sites": "node node_modules/vite/bin/vite.js build --configLoader native",
    "build:selfhost": "node scripts/build-selfhost.mjs",
    "start": "vinext start",
    "start:selfhost": "node scripts/start-selfhost.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "smoke:selfhost": "node scripts/smoke-selfhost.mjs",
    "release:check": "npm run build:selfhost && npm run release:verify && npm run smoke:selfhost",
    "release:gate": "node scripts/release-gate.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "data:build": "node scripts/build-review.mjs",
    "data:verify": "node scripts/verify-data.mjs",
    "data:audit-math": "node scripts/audit-math.mjs",
    "data:check": "node scripts/check-data.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "katex": "^0.18.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "gray-matter": "^4.0.3",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
